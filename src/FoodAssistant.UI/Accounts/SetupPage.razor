@page "/setup"
@using FoodAssistant.Client.Accounts
@using FoodAssistant.Client.Http
@using FoodAssistant.Contracts.Accounts
@inject IAccountClient Accounts
@inject SessionState Session
@inject NavigationManager Navigation
@inject ILiveAnnouncer Announcer
@inject IStringLocalizer<AccountsText> T

<PageTitle>@T["SetupTitle"] – @AppInfo.Name</PageTitle>

<h1>@T["SetupTitle"]</h1>
<p>@T["SetupIntro"]</p>

<form class="fa-account-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
    <ApiErrorAlert Error="_error" FeatureText="T" />
    <MudTextField T="string" @bind-Value="_displayName" Label="@T["FieldDisplayName"]" Variant="Variant.Outlined"
                  Required="true" RequiredError="@T["FieldError.required"]" Immediate="true" Error="@HasError("displayName")" ErrorText="@Field("displayName")"
                  UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "name" })" />
    <MudTextField T="string" @bind-Value="_userName" Label="@T["FieldUserName"]" Variant="Variant.Outlined"
                  Required="true" RequiredError="@T["FieldError.required"]" Immediate="true" Error="@HasError("userName")" ErrorText="@Field("userName")"
                  UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "username" })" />
    <MudTextField T="string" @bind-Value="_password" Label="@T["FieldPassword"]" Variant="Variant.Outlined"
                  InputType="InputType.Password" Required="true" RequiredError="@T["FieldError.required"]" Immediate="true" HelperText="@T["PasswordHint"]"
                  Error="@HasError("password")" ErrorText="@Field("password")"
                  UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
    <MudTextField T="string" @bind-Value="_passwordRepeat" Label="@T["FieldPasswordRepeat"]" Variant="Variant.Outlined"
                  InputType="InputType.Password" Required="true" RequiredError="@T["FieldError.required"]" Immediate="true"
                  Error="@(_repeatError is not null)" ErrorText="@_repeatError"
                  UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })" />
    <MudTextField T="string" @bind-Value="_householdName" Label="@T["FieldHouseholdName"]" Variant="Variant.Outlined"
                  Required="true" RequiredError="@T["FieldError.required"]" Immediate="true" Error="@HasError("householdName")" ErrorText="@Field("householdName")" />
    <TimeZoneField @bind-Value="_timeZone" ErrorText="@Field("timeZone")" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
        @(_busy ? T["SetupBusy"] : T["SetupSubmit"])
    </MudButton>
</form>

@code {
    private string _displayName = string.Empty;
    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string _passwordRepeat = string.Empty;
    private string _householdName = string.Empty;
    private string _timeZone = string.Empty;
    private string? _repeatError;
    private bool _busy;
    private ApiError? _error;

    private bool HasError(string field) => Field(field) is not null;

    private string? Field(string field) => AccountsKeys.FieldError(T, _error, field);

    // Setup is open only while no account exists; anything else belongs on another page.
    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        switch (Session.Status)
        {
            case SessionStatus.Ready or SessionStatus.NoHousehold:
                Navigation.NavigateTo("/", replace: true);
                break;
            case SessionStatus.SignedOut:
                Navigation.NavigateTo("/login", replace: true);
                break;
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _error = null;
        _repeatError = _password == _passwordRepeat ? null : T["FieldError.password_mismatch"].Value;
        if (_repeatError is not null)
        {
            Announcer.Announce(_repeatError);
            return;
        }

        _busy = true;
        var userName = _userName.Trim();
        var setup = await Accounts.SetupAsync(
            new SetupRequest(userName, _password, _displayName.Trim(), _householdName.Trim(), _timeZone.Trim()), CancellationToken.None);
        if (!setup.IsSuccess)
        {
            _error = setup.Error;
            _busy = false;
            return;
        }

        // The new account signs in right away; if that fails, the login page is the way on.
        var login = await Accounts.LoginAsync(new LoginRequest(userName, _password), CancellationToken.None);
        ClearPasswords();
        await Session.LoadAsync();
        _busy = false;
        Navigation.NavigateTo(login.IsSuccess ? "/" : "/login", replace: true);
    }

    private void ClearPasswords()
    {
        _password = string.Empty;
        _passwordRepeat = string.Empty;
    }
}
