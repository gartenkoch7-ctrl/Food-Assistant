@inherits LayoutComponentBase
@inject IStringLocalizer<ShellText> T

<ThemeHost>
    <SkipLink TargetId="main-content" />
    <div class="fa-shell">
        <div class="fa-chrome">
            <header class="fa-header">
                <span class="fa-wordmark">@AppInfo.Name</span>
                <FoodAssistant.UI.Sync.LiveStatusIndicator />
            </header>
            <AppNav />
        </div>
        <main id="main-content" class="fa-main" tabindex="-1">
            <SessionGate>@Body</SessionGate>
        </main>
    </div>
    <LiveRegion />
</ThemeHost>

@* Shown by the Blazor runtime on an unhandled exception. *@
<div id="blazor-error-ui" role="alert" data-nosnippet>
    @T["ErrorMessage"]
    <a href="." class="reload">@T["ErrorReload"]</a>
    <button type="button" class="dismiss" aria-label="@T["ErrorDismiss"]">
        <MudIcon Icon="@Icons.Material.Rounded.Close" />
    </button>
</div>
