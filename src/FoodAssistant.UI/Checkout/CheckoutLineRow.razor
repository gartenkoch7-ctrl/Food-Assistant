@using System.Globalization
@using FoodAssistant.Contracts.Catalog
@using FoodAssistant.Contracts.Common
@using FoodAssistant.Contracts.Inventory
@using FoodAssistant.UI.Inventory
@inject IStringLocalizer<CheckoutText> T
@inject IStringLocalizer<InventoryText> Inventory
@inject IStringLocalizer<CommonText> Common

@* One bought entry: a heading with its name, the suggested values as text, location choice and actions. *@
<li class="fa-checkout-row @(Line.Skip ? "fa-checkout-row--skipped" : null)">
    <h2 class="fa-checkout-name">@Line.Name</h2>
    @if (Line.Skip)
    {
        <p class="fa-checkout-secondary">@T["Skipped"]</p>
        <div class="fa-checkout-actions">
            <MudButton Variant="Variant.Text" aria-label="@Format("UnskipLabel")" OnClick="() => SetSkipAsync(false)">@T["Unskip"]</MudButton>
        </div>
    }
    else
    {
        @if (Line.ProductId is null)
        {
            <ProductPicker Label="@Format("AssignLabel", Line.Text)" ProductSelected="AssignAsync" />
        }
        else if (Line.Reassignable)
        {
            <p class="fa-checkout-secondary">@Format("AssignedFrom", Line.Text)</p>
        }
        <p class="fa-checkout-secondary">@InventoryFields.Quantity(Line.Quantity, Common, CultureInfo.CurrentCulture) · @DateText</p>
        @* Frozen at home (no date, or "selbst eingefroren"): the server dates it by the rule, a package date rests. *@
        @if (IsFreezer && (Line.Date is null || Line.SelfFrozen))
        {
            <p class="fa-checkout-secondary">@Inventory["FrozenAtHomeHint"]</p>
        }
        @* The label names the line: every row has a location field, and a list of "Lagerort" fields is ambiguous. *@
        <MudSelect T="Guid?" Label="@Format("LocationLabel")" Value="Line.LocationId" ValueChanged="MoveAsync"
                   Variant="Variant.Outlined" Dense="true" Required="true">
            @foreach (var location in Locations)
            {
                <MudSelectItem T="Guid?" Value="@location.Id">@location.Name</MudSelectItem>
            }
        </MudSelect>
        <div class="fa-checkout-actions">
            <MudButton Variant="Variant.Outlined" aria-label="@Format("EditLabel")" OnClick="() => Edit.InvokeAsync(Line)">@T["Edit"]</MudButton>
            @if (Line.Reassignable && Line.ProductId is not null)
            {
                <MudButton Variant="Variant.Text" aria-label="@Format("AssignOtherLabel", Line.Text)" OnClick="UnassignAsync">@T["AssignOther"]</MudButton>
            }
            <MudButton Variant="Variant.Text" aria-label="@Format("SkipLabel")" OnClick="() => SetSkipAsync(true)">@T["Skip"]</MudButton>
        </div>
    }
    @* No role="alert" here: the page announces one summary instead of every line at once. *@
    @if (Error is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">@Error</MudText>
    }
</li>

@code {
    [Parameter, EditorRequired]
    public CheckoutLine Line { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<StorageLocationDto> Locations { get; set; } = [];

    /// <summary>Default storage type per category key, for a product assigned to free text.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, StorageTypeDto> CategoryTypes { get; set; } = new Dictionary<string, StorageTypeDto>();

    /// <summary>Problem of this line (missing product, field error of the server), shown under it.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Raised after the line changed in place (location, product, skip).</summary>
    [Parameter]
    public EventCallback<CheckoutLine> Changed { get; set; }

    /// <summary>Asks the page to open the editor for the line.</summary>
    [Parameter]
    public EventCallback<CheckoutLine> Edit { get; set; }

    private bool IsFreezer => Locations.FirstOrDefault(l => l.Id == Line.LocationId)?.Type == StorageTypeDto.Frozen;

    private string DateText => Line.Date is { } date
        ? string.Format(CultureInfo.CurrentCulture, T["DateLine"].Value, Inventory["Kind." + Line.Kind].Value, date.ToString("d", CultureInfo.CurrentCulture))
            + (Line.FromRule ? $" · {T["FromRule"].Value}" : string.Empty)
            + (IsFreezer && Line.SelfFrozen ? $" · {T["DateResting"].Value}" : string.Empty)
        : Inventory["ExpiryNoDate"].Value;

    private string Format(string key) => Format(key, Line.Name);

    private string Format(string key, string value) => string.Format(CultureInfo.CurrentCulture, T[key].Value, value);

    // Chosen by the person: an assigned product no longer moves the line.
    private Task MoveAsync(Guid? locationId)
    {
        Line.LocationIsDefault = false;
        Move(locationId);
        return Changed.InvokeAsync(Line);
    }

    private void Move(Guid? locationId)
    {
        var freezer = Locations.FirstOrDefault(l => l.Id == locationId)?.Type == StorageTypeDto.Frozen;
        Line.MoveTo(locationId, freezer, IsFreezer);
    }

    // Free text was suggested "1 piece" in the first location; the product's own defaults fit better
    // (default unit, a location of its category's storage type), as the server suggests for products.
    private Task AssignAsync(ProductSummaryDto product)
    {
        Line.AssignProduct(product.Id, product.Name, product.DefaultUnit);

        // Only free text got the generic location (the first one), and only while nobody chose another;
        // a product line (picker shown again because its product was archived) keeps its location.
        if (Line.LocationIsDefault
            && CategoryTypes.TryGetValue(product.CategoryKey, out var type)
            && Locations.FirstOrDefault(l => l.Type == type) is { } location)
        {
            Move(location.Id);
        }

        return Changed.InvokeAsync(Line);
    }

    private Task UnassignAsync()
    {
        Line.ClearProduct();
        return Changed.InvokeAsync(Line);
    }

    private Task SetSkipAsync(bool skip)
    {
        Line.Skip = skip;
        return Changed.InvokeAsync(Line);
    }
}
