<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Required for the language switch: the runtime refuses to change the culture during start-up
      (we apply the stored language before the first render, ADR-0008) unless all ICU data is loaded.
      It also covers future community languages. Cost: a larger first download.
    -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FoodAssistant.UI\FoodAssistant.UI.csproj" />
    <ProjectReference Include="..\FoodAssistant.Client\FoodAssistant.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
