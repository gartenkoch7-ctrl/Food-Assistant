<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#c0391f" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="@Assets["icon.svg"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/FoodAssistant.UI/design-tokens.css"]" />
    <link rel="stylesheet" href="@Assets["_content/FoodAssistant.UI/base.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FoodAssistant.Server.styles.css"]" />
    @* Synchronous on purpose: applies the stored theme before the first paint. *@
    <script src="@Assets["_content/FoodAssistant.UI/foodassistant.js"]"></script>
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["pwa.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // The error page lives on the server only; the WebAssembly router would not know it and show "not found".
    // No prerendering: the server would have to forward the sign-in cookie to itself for every data page (plan M1).
    private static readonly IComponentRenderMode WebAssemblyNoPrerender = new InteractiveWebAssemblyRenderMode(prerender: false);

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? WebAssemblyNoPrerender : null;
}
