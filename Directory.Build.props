<Project>
  <!-- Shared build rules for all projects (AGENTS.md, section 5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <Company>Food-Assistant contributors</Company>
    <Product>Food-Assistant</Product>
    <Copyright>Copyright (c) Food-Assistant contributors. MIT License.</Copyright>
  </PropertyGroup>
</Project>
