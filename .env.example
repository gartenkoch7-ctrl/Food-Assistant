# Copy to .env next to docker-compose.yml and fill in. Never commit .env (it is in .gitignore).
# Guide: deploy/README.md

# Required: database password (long random string, e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=

# Required: address under which phones and browsers reach the server, e.g. https://food.example.com.
# For a first local test: http://localhost:8080 (only works on this machine; phones need HTTPS).
FOODASSISTANT_PUBLICURL=

# Only with deploy/caddy: domain for the HTTPS certificate, e.g. food.example.com.
FOODASSISTANT_DOMAIN=

# Optional: trusted reverse proxies (IPs/CIDR, comma-separated). Default: 172.16.0.0/12 (Docker networks).
FOODASSISTANT_TRUSTEDPROXIES=

# Optional: OpenTelemetry collector, e.g. http://otel-collector:4317. Empty: no telemetry leaves the server.
OTEL_EXPORTER_OTLP_ENDPOINT=
