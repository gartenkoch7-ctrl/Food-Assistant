  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "required": [
          "requestToken",
          "headerName"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "ChangeMemberRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "CreateHouseholdRequest": {
        "required": [
          "name",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "HouseholdRole": {
        "enum": [
          "restricted",
          "member",
          "owner"
        ]
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ServerFeaturesDto": {
        "required": [
          "ai"
        ],
        "type": "object",
        "properties": {
          "ai": {
            "type": "boolean"
          }
        }
      },
      "ServerInfoDto": {
        "required": [
          "serverVersion",
          "minimumAppVersion",
          "apiVersions",
          "features"
        ],
        "type": "object",
        "properties": {
          "serverVersion": {
            "type": "string"
          },
          "minimumAppVersion": {
            "type": "string"
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "$ref": "#/components/schemas/ServerFeaturesDto"
          }
        }
      },
      "SetupRequest": {
        "required": [
          "userName",
          "password",
          "displayName",
          "householdName",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "householdName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "ShelfLifeDaysDto": {
        "required": [
          "daysAfterOpening",
          "daysFrozen",
          "daysAfterThawing",
          "daysAsLeftover"
        ],
        "type": "object",
        "properties": {
          "daysAfterOpening": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "daysFrozen": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "daysAfterThawing": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "daysAsLeftover": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ShelfLifeRuleRowDto": {
        "required": [
          "categoryKey",
          "storageType",
          "default",
          "override",
          "effective",
          "sourceKey"
        ],
        "type": "object",
        "properties": {
          "categoryKey": {
            "type": "string"
          },
          "storageType": {
            "$ref": "#/components/schemas/StorageTypeDto"
          },
          "default": {
            "$ref": "#/components/schemas/ShelfLifeDaysDto"
          },
          "override": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ShelfLifeDaysDto"
              }
            ]
          },
          "effective": {
            "$ref": "#/components/schemas/ShelfLifeDaysDto"
          },
          "sourceKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ShelfLifeSourceDto": {
        "required": [
          "key",
          "title",
          "url",
          "retrieved"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "StorageTypeDto": {
        "enum": [
          "chilled",
          "frozen",
          "ambient"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Info"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Invitations"
    },
    {
      "name": "Setup"
    },
    {
      "name": "Households"
    },
    {
      "name": "Members"
    },
    {
      "name": "ShelfLife"
    }
  ]
}
