  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "required": [
          "requestToken",
          "headerName"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "ChangeMemberRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "ChangeShoppingItemRequest": {
        "required": [
          "baseVersion",
          "checked",
          "quantity",
          "note",
          "text",
          "sectionKey"
        ],
        "type": "object",
        "properties": {
          "baseVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "checked": {
            "type": "boolean"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityDto"
              }
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "text": {
            "type": "string"
          },
          "sectionKey": {
            "type": "string"
          }
        }
      },
      "CreateHouseholdRequest": {
        "required": [
          "name",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "CreateShoppingItemRequest": {
        "required": [
          "id",
          "productId",
          "text",
          "quantity",
          "note",
          "sectionKey"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "productId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "quantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityDto"
              }
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "sectionKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateShoppingListRequest": {
        "required": [
          "id",
          "name",
          "storeId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "storeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "HouseholdRole": {
        "enum": [
          "restricted",
          "member",
          "owner"
        ]
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MoveShoppingItemRequest": {
        "required": [
          "listId"
        ],
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "QuantityDto": {
        "required": [
          "value",
          "unit"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "ServerFeaturesDto": {
        "required": [
          "ai"
        ],
        "type": "object",
        "properties": {
          "ai": {
            "type": "boolean"
          }
        }
      },
      "ServerInfoDto": {
        "required": [
          "serverVersion",
          "minimumAppVersion",
          "apiVersions",
          "features"
        ],
        "type": "object",
        "properties": {
          "serverVersion": {
            "type": "string"
          },
          "minimumAppVersion": {
            "type": "string"
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "$ref": "#/components/schemas/ServerFeaturesDto"
          }
        }
      },
      "SetupRequest": {
        "required": [
          "userName",
          "password",
          "displayName",
          "householdName",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "householdName": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "ShoppingConflictOutcomeDto": {
        "enum": [
          "created",
          "no_conflict",
          "checked_wins",
          "change_wins_over_delete",
          "checked_wins_over_delete",
          "both_deleted",
          "last_write_wins"
        ]
      },
      "ShoppingItemChangeResult": {
        "required": [
          "item",
          "outcome"
        ],
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ShoppingItemDto"
          },
          "outcome": {
            "$ref": "#/components/schemas/ShoppingConflictOutcomeDto"
          }
        }
      },
      "ShoppingItemDto": {
        "required": [
          "id",
          "listId",
          "productId",
          "text",
          "quantity",
          "note",
          "sectionKey",
          "origin",
          "checked",
          "checkedAt",
          "version",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "listId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityDto"
              }
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "sectionKey": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/ShoppingItemOriginDto"
          },
          "checked": {
