  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AddBatchRequest": {
        "required": [
          "id",
          "productId",
          "storageLocationId",
          "quantity",
          "packageExpiresOn",
          "packageExpiryKind",
          "origin",
          "selfFrozen"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "storageLocationId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityDto"
          },
          "packageExpiresOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "packageExpiryKind": {
            "$ref": "#/components/schemas/ExpiryKindDto"
          },
          "origin": {
            "$ref": "#/components/schemas/BatchOriginDto"
          },
          "selfFrozen": {
            "type": "boolean"
          }
        }
      },
      "AntiforgeryTokenResponse": {
        "required": [
          "requestToken",
          "headerName"
        ],
        "type": "object",
        "properties": {
          "requestToken": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        }
      },
      "BatchOriginDto": {
        "enum": [
          "manual",
          "scanned",
          "purchase",
          "import",
          "leftover"
        ]
      },
      "ChangeMemberRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "ConsumeBatchRequest": {
        "required": [
          "kind",
          "quantity",
          "reason"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConsumptionKindDto"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityDto"
              }
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConsumptionReasonDto"
              }
            ]
          }
        }
      },
      "ConsumeProductRequest": {
        "required": [
          "kind",
          "quantity",
          "reason"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConsumptionKindDto"
          },
          "quantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityDto"
              }
            ]
          },
          "reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConsumptionReasonDto"
              }
            ]
          }
        }
      },
      "ConsumptionKindDto": {
        "enum": [
          "used_up",
          "partial",
          "discarded"
        ]
      },
      "ConsumptionReasonDto": {
        "enum": [
          "expired",
          "spoiled",
          "disliked_taste",
          "too_much_cooked",
          "other",
          null
        ]
      },
      "CorrectBatchRequest": {
        "required": [
          "quantity",
          "packageExpiresOn",
          "packageExpiryKind"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "$ref": "#/components/schemas/QuantityDto"
          },
          "packageExpiresOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "packageExpiryKind": {
            "$ref": "#/components/schemas/ExpiryKindDto"
          }
        }
      },
      "CreateHouseholdRequest": {
        "required": [
          "name",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        }
      },
      "CreateInvitationRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          }
        }
      },
      "CreateLeftoverRequest": {
        "required": [
          "id",
          "productId",
          "storageLocationId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "storageLocationId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityDto"
          }
        }
      },
      "ExpiryKindDto": {
        "enum": [
          "none",
          "best_before",
          "use_by"
        ]
      },
      "HouseholdRole": {
        "enum": [
          "restricted",
          "member",
          "owner"
        ]
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MoveBatchRequest": {
        "required": [
          "storageLocationId"
        ],
        "type": "object",
        "properties": {
          "storageLocationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "QuantityDto": {
        "required": [
          "value",
          "unit"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "ServerFeaturesDto": {
        "required": [
          "ai"
        ],
        "type": "object",
        "properties": {
          "ai": {
            "type": "boolean"
          }
        }
      },
      "ServerInfoDto": {
        "required": [
          "serverVersion",
          "minimumAppVersion",
          "apiVersions",
          "features"
        ],
        "type": "object",
        "properties": {
          "serverVersion": {
            "type": "string"
          },
          "minimumAppVersion": {
            "type": "string"
          },
          "apiVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "$ref": "#/components/schemas/ServerFeaturesDto"
          }
        }
      },
      "SetupRequest": {
        "required": [
          "userName",
          "password",
          "displayName",
          "householdName",
          "timeZone"
        ],
